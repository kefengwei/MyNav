{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MyNav 导航数据",
  "description": "data/links.json 的结构定义，供编辑器补全与校验",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "description": "站点级别的元信息",
      "properties": {
        "title": { "type": "string", "description": "站点标题（浏览器标签页）", "default": "MyNav" },
        "subtitle": { "type": "string", "description": "顶栏副标题" },
        "updated": {
          "type": "string",
          "description": "页脚显示的更新日期，格式 YYYY-MM-DD",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "description": "分类数组，顺序即页面顺序",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "links"],
        "properties": {
          "id": {
            "type": "string",
            "description": "锚点 id，英文/数字/连字符，全局唯一",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": { "type": "string", "minLength": 1, "description": "分类显示名" },
          "emoji": { "type": "string", "description": "分类图标，可选" },
          "links": {
            "type": "array",
            "description": "该分类下的链接",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "description": "链接名称" },
                "url": {
                  "type": "string",
                  "description": "网址，必须以 http(s):// 开头",
                  "pattern": "^https?://"
                },
                "desc": { "type": "string", "description": "一句话描述" },
                "icon": {
                  "type": "string",
                  "description": "图标：图片路径（如 data/icons/x.png）、data URI 或单个 emoji；留空则用首字母色块"
                },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "搜索用标签"
                },
                "keywords": { "type": "string", "description": "额外搜索词，空格分隔（如拼音首字母）" }
              }
            }
          }
        }
      }
    }
  }
}
